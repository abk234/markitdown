# Copy to markitdown-app.env (gitignored) and adjust.

# SquadOS checkout (infra + .env with LiteLLM keys)
SQUADOS_ROOT=$HOME/workspace_for_ai/1/SquadOS

# Optional port overrides (defaults match SquadOS)
LITELLM_PORT=4001
# SEARXNG not used by MarkItDown

# MCP HTTP (start command)
MCP_HOST=127.0.0.1
MCP_PORT=3001

# Python
PYTHON_BIN=python3.12
VENV_DIR=.venv
INSTALL_EXTRAS=all

# Backup
BACKUP_DIR=../markitdown-backups
BACKUP_INTERVAL_DAYS=30
BACKUP_KEEP=3
UPDATE_SYNC_ON_UPDATE=true

# Telemetry: ONNX Runtime (Dockerfile already sets this; export at host start too)
ORT_DISABLE_TELEMETRY=1
